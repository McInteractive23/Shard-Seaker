config_version=5

[application]

config/name="Shard Seaker"
run/main_scene="uid://c2ecbnmtmkg4w"
config/features=PackedStringArray("4.4", "Forward Plus")
run/max_fps=60
config/icon="res://icon.svg"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/inferred_declaration=1

[display]

window/size/viewport_width=320
window/size/viewport_height=240
window/size/always_on_top=true
window/stretch/mode="viewport"

[editor]

movie_writer/mjpeg_quality=1.0
movie_writer/movie_file="C:/Users/sdmes/Videos/Godot Capture/Test.avi"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/inspector_tabs/plugin.cfg")

